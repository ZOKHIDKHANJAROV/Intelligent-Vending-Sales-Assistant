OLLAMA_EMBEDDING_MODEL=nomic-embed-text

NEXT_PUBLIC_API_URL=http://localhost:8000

# Admin API secret. Change before public deployment.
ADMIN_API_KEY=change_this_to_a_long_random_secret

# Telegram bot token. Never commit the real token to Git.
TELEGRAM_BOT_TOKEN=change_this_to_your_telegram_bot_token
BACKEND_URL=http://backend:8000
