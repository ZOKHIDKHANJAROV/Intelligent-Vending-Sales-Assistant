POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://vendai:change_me@postgres:5432/vendai

QDRANT_HOST=qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
