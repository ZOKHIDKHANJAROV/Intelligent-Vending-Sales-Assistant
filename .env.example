POSTGRES_DB=vendai
POSTGRES_USER=vendai
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://vendai:change_me@postgres:5432/vendai

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=vendai_knowledge

# Ollama runs on the Ubuntu host, not in Docker.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# Leave empty until an embedding model is installed.
# RAG retrieval is disabled when this is empty.
OLLAMA_EMBEDDING_MODEL=

NEXT_PUBLIC_API_URL=http://localhost:8000

ADMIN_API_KEY=change_this_to_a_long_random_secret
TELEGRAM_BOT_TOKEN=change_this_to_your_telegram_bot_token
BACKEND_URL=http://backend:8000
